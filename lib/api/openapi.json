  "components": {
    "schemas": {
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "category_id": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ],
            "title": "Category Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "required": ["id", "name", "description", "price", "category_id", "created_at"],
        "title": "ProductResponse"
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description",
            "default": null
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "category_id": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ],
            "title": "Category Id",
            "default": null
          }
        },
        "required": ["name", "price"],
        "title": "ProductCreate"
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Name",
            "default": null
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description",
            "default": null
          },
          "price": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Price",
            "default": null
          },
          "category_id": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ],
            "title": "Category Id",
            "default": null
          }
        },
        "title": "ProductUpdate"
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description"
          }
