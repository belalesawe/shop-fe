        "title": "CategoryResponse"
      },
      "CategoryCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description",
            "default": null
          }
        },
        "required": ["name"],
        "title": "CategoryCreate"
      },
      "CategoryUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Name",
            "default": null
          },
          "description": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Description",
